meta {
  name: import csv invalid
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/invoices/import
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  file: @file(fixtures/invoices-invalid.csv)
}

assert {
  res.status: eq 202
  res.body.importId: isString
  res.body.status: eq pending
}

script:post-response {
  bru.setVar("importId", res.body.importId);
}

docs {
  Every row in bruno/fixtures/invoices-invalid.csv breaks a rule (email, amount, currency, future paidAt).
  The upload is accepted with 202. Run "import status": it says failed, nothing was imported, and errors lists each bad row and field.
  Line 3 of the file is blank, so the errors point at rows 2, 4 and 5, the same numbers you see in a spreadsheet.
}
