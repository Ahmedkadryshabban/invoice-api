meta {
  name: import csv invalid
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/invoices/import
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  file: @file(fixtures/invoices-invalid.csv)
}

assert {
  res.status: eq 400
  res.body.errors: isArray
  res.body.errors[0].row: eq 2
  res.body.errors[3].row: eq 5
}

docs {
  Every row in bruno/fixtures/invoices-invalid.csv breaks a rule (email, amount, currency, future paidAt).
  The whole file is rejected and the response lists each bad row and field.
  Line 3 of the file is blank, so the errors point at rows 2, 4 and 5, the same numbers you see in a spreadsheet.
}
