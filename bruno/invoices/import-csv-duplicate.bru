meta {
  name: import csv duplicate
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/invoices/import
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  file: @file(fixtures/invoices.csv)
}

assert {
  res.status: eq 409
}

docs {
  Run after "import csv": the same file is rejected with 409 and nothing is saved.
}
