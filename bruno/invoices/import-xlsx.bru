meta {
  name: import xlsx
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/invoices/import
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  file: @file(fixtures/invoices.xlsx)
}

assert {
  res.status: eq 201
  res.body.importedCount: eq 3
  res.body.importId: isString
}

docs {
  Imports bruno/fixtures/invoices.xlsx as paid invoices.
  You get one summary email; customers are not emailed.
  The same file can only be imported once per user: run it again and it returns 409.
}
