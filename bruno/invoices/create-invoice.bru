meta {
  name: create invoice
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/invoices
  body: json
  auth: inherit
}

body:json {
  {
    "customerEmail": "customer@example.com",
    "description": "Website design",
    "amountCents": 15000,
    "currency": "usd"
  }
}

assert {
  res.status: eq 201
  res.body.status: eq pending
  res.body.paymentUrl: isString
}

script:post-response {
  bru.setVar("invoiceId", res.body.id);
  bru.setVar("paymentUrl", res.body.paymentUrl);
}
