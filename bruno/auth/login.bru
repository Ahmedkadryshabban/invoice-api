meta {
  name: login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

assert {
  res.status: eq 200
  res.body.accessToken: isString
}

script:post-response {
  bru.setVar("accessToken", res.body.accessToken);
}
